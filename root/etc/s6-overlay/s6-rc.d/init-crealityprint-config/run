#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Prepare /config for Creality Print before the desktop starts, and check CP_UI_SCALE.
# Runs as root after the base image's init-config and before init-config-end, so also before
# the Selkies server reads its environment.

readonly config_home="/config"
readonly app_config_root="${config_home}/.config/Creality/Creality Print"
readonly defaults_dir="/defaults/crealityprint"
# The Selkies upload folder (Selkies reads SELKIES_FILE_MANAGER_PATH before FILE_MANAGER_PATH);
# the app's Import/Export dialogs are pointed at it on first run.
readonly upload_dir="${SELKIES_FILE_MANAGER_PATH:-${FILE_MANAGER_PATH:-${config_home}/Desktop}}"
# Where s6 keeps the environment that services started with with-contenv (Selkies) get. s6
# rebuilds it from the container's environment on every start, also after `docker restart`.
readonly env_dir="/run/s6/container_environment"
# Selkies' DPI for UI Scaling 100 %: the desktop gets the browser's full device resolution.
readonly sharp_dpi="96"

log() {
  echo "[crealityprint-init] $*"
}

# Desktop and app state the desktop user must own. Re-owned recursively when needed.
readonly owned_state_dirs=(
  "${config_home}/.config"
  "${config_home}/.local"
  "${config_home}/.cache"
  "${config_home}/.Creality"
  # X11 D-Bus autolaunch state (mode 0700). If abc can't read it, the app gets no session
  # bus and the upload watcher can't hand files to it.
  "${config_home}/.dbus"
)

# Print the first path (two levels deep) in the state dirs whose owner or group isn't abc's, if
# any. Two levels, because the base image re-owns the top-level dirs (e.g. /config/.config)
# but not what is inside them.
first_foreign_owned_path() {
  local expected_uid="$1"
  local expected_gid="$2"
  local existing_dirs=()
  local state_dir
  for state_dir in "${owned_state_dirs[@]}"; do
    if [ -d "$state_dir" ]; then
      existing_dirs+=("$state_dir")
    fi
  done
  if [ "${#existing_dirs[@]}" -eq 0 ]; then
    return
  fi
  find "${existing_dirs[@]}" -maxdepth 2 \( ! -uid "$expected_uid" -o ! -gid "$expected_gid" \) \
    -print -quit 2> /dev/null
}

# Why: the base image only fixes ownership of the top-level dirs. After a PUID/PGID change
# the files inside still belong to the old user and the desktop never starts (black screen;
# docs/research/persistence.md). The upload folder is only re-owned at its top level, so a NAS
# share mounted below it is never chowned.
repair_ownership() {
  local expected_uid expected_gid foreign_path
  expected_uid="$(id -u abc)"
  expected_gid="$(id -g abc)"
  foreign_path="$(first_foreign_owned_path "$expected_uid" "$expected_gid")"
  if [ -z "$foreign_path" ]; then
    return
  fi

  log "${foreign_path} is not owned by ${expected_uid}:${expected_gid}; re-owning the desktop and app state in ${config_home}"
  local state_dir
  for state_dir in "${owned_state_dirs[@]}"; do
    if [ -d "$state_dir" ]; then
      lsiown -R abc:abc "$state_dir"
    fi
  done
  if [ -d "$upload_dir" ]; then
    lsiown abc:abc "$upload_dir"
  fi
}

# Why: an app data dir that already exists (from any version) means the user has settings,
# or the app has its own migration to run (7.0 -> 7.3). Seeding then would block that.
app_data_exists() {
  local existing_dir
  for existing_dir in "$app_config_root"/[0-9]*/; do
    if [ -d "$existing_dir" ]; then
      return 0
    fi
  done
  return 1
}

# The full app version (e.g. 7.3.2.6412) from the AppImage asset name in /build_version.
full_app_version() {
  grep -oE 'CrealityPrint-V[0-9.]+-' /build_version \
    | sed -E 's/^CrealityPrint-V//; s/-$//'
}

# The app keeps its data in a "<major>.<minor>" directory (e.g. 7.3 for 7.3.x).
data_version() {
  local version="$1"
  echo "$version" | cut -d. -f1-2
}

seed_first_run() {
  if app_data_exists; then
    return
  fi

  local app_version data_dir
  app_version="$(full_app_version)"
  if [ -z "$app_version" ]; then
    log "could not read the app version from /build_version; not seeding"
    return
  fi
  data_dir="${app_config_root}/$(data_version "$app_version")"

  log "first run: seeding ${data_dir}"
  mkdir -p "$data_dir"
  # Declines the "User Experience Improvement Program" (telemetry) dialog.
  cp "${defaults_dir}/privacyInfo.json" "${data_dir}/privacyInfo.json"
  if ! crealityprint-seed-config "$app_version" > "${data_dir}/Creality.conf"; then
    log "seed generation failed; removing the seed so the app starts clean"
    rm -rf "$data_dir"
  fi
  # Also on failure: mkdir -p above may have created the parent dirs as root.
  lsiown -R abc:abc "${config_home}/.config/Creality"
}

# Why: the Selkies web client picks its UI Scaling from the browser's devicePixelRatio, so a
# HiDPI browser starts at 200 %. Selkies applies that as labwc's output scale, which stretches
# this Xwayland app as a bitmap: on top of GDK_SCALE the app would come out 4x and blurry.
# A server-side DPI of 96 gives every browser the full-resolution desktop at scale 1 instead
# (docs/research/hidpi.md). Selkies then ignores the client's choice and hides the setting.
pin_selkies_dpi() {
  local requested_scale="$1"
  local user_dpi="${SELKIES_SCALING_DPI:-}"

  if [ -n "$user_dpi" ]; then
    local advice=""
    if [ "$user_dpi" != "$sharp_dpi" ]; then
      advice="; the app is only sharp at ${sharp_dpi}"
    fi
    log "UI scale ${requested_scale}: keeping your SELKIES_SCALING_DPI=${user_dpi}${advice}"
    return
  fi

  if ! printf '%s' "$sharp_dpi" > "${env_dir}/SELKIES_SCALING_DPI"; then
    log "UI scale ${requested_scale}: could not set SELKIES_SCALING_DPI=${sharp_dpi} in ${env_dir}; on a HiDPI browser the app may be blurry"
    return
  fi
  log "UI scale ${requested_scale}: Selkies' UI Scaling fixed at 100 % (SELKIES_SCALING_DPI=${sharp_dpi}) so the app is drawn sharp at the browser's full resolution"
}

# Why: the launcher applies CP_UI_SCALE where the app starts, and that output never reaches the
# container log. So the value is checked here too, with the launcher's rule (a whole number
# from 1 to 4). A valid scale also pins Selkies' DPI, and the result is logged once per start.
configure_ui_scale() {
  local requested_scale="${CP_UI_SCALE:-}"
  if [ -z "$requested_scale" ]; then
    return
  fi
  if [[ ! "$requested_scale" =~ ^[1-4]$ ]]; then
    log "ignoring CP_UI_SCALE=${requested_scale}: use a whole number from 1 to 4 (e.g. 2)"
    return
  fi
  if [ "$requested_scale" = "1" ]; then
    # 1 leaves a GDK_SCALE from the container's environment in place, as the launcher does.
    return
  fi
  pin_selkies_dpi "$requested_scale"
}

repair_ownership
seed_first_run
configure_ui_scale
