#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Opt-in close when idle (IDLE_QUIT=true): install Selkies' presence hooks and the runtime dir
# that the hooks and svc-crealityprint-idle share (see /usr/local/bin/crealityprint-idle).
# Runs as root after the base image's init-config and before the Selkies server starts.

readonly env_dir="/run/s6/container_environment"
readonly runtime_dir="/run/crealityprint-idle"
readonly connect_hook="/usr/local/bin/crealityprint-idle connect"
readonly disconnect_hook="/usr/local/bin/crealityprint-idle disconnect"

log() {
  echo "[crealityprint-idle] $*"
}

idle_quit_enabled() {
  local idle_quit="${IDLE_QUIT:-false}"
  [ "${idle_quit,,}" = "true" ]
}

# A hook value that isn't ours means the user set their own.
is_foreign_hook() {
  local hook_value="$1"
  local own_hook="$2"
  [ -n "$hook_value" ] && [ "$hook_value" != "$own_hook" ]
}

# Why: /run isn't a tmpfs in Docker, so a previous start's FIFO and hooks may still be there.
# Clear them every start, so turning IDLE_QUIT off really turns everything off.
clear_previous_state() {
  rm -rf "$runtime_dir"
  if [ "${SELKIES_RUN_AFTER_CONNECT:-}" = "$connect_hook" ]; then
    rm -f "${env_dir}/SELKIES_RUN_AFTER_CONNECT"
  fi
  if [ "${SELKIES_RUN_AFTER_DISCONNECT:-}" = "$disconnect_hook" ]; then
    rm -f "${env_dir}/SELKIES_RUN_AFTER_DISCONNECT"
  fi
}

# Nobody is connected at boot, so the state starts "absent" and the daemon arms its timer.
create_runtime_dir() {
  mkdir -p "$runtime_dir"
  mkfifo "${runtime_dir}/events"
  printf 'absent\n' > "${runtime_dir}/clients"
  chown -R abc:abc "$runtime_dir"
  chmod 0700 "$runtime_dir"
}

# A setting is on when it reads "true" in any case. The part before a "|" counts, because
# Selkies settings may be written as "<value>|locked". The base reads RESTART_APP and
# EXIT_ON_APP_CLOSE without that strip, so "true|locked" there may be a false alarm: that errs
# on the safe side.
is_true() {
  local value="${1:-}"
  value="${value%%|*}"
  [ "${value,,}" = "true" ]
}

# Why: a base that restarts the app when it exits undoes every idle close, or turns it into a
# container stop.
# - Python Selkies base (today): RESTART_APP=true runs svc-watchdog, which starts the autostart
#   again about a second after the app exits. The daemon then waits for a browser while the app
#   runs with nobody connected and the quit marker set, so the app is never closed again and
#   file-API uploads are skipped (docs/research/13 §3.7). HARDEN_OPENBOX=true turns RESTART_APP
#   on unless the user set it; init-selkies-config writes that before this init runs (we come
#   after init-config, which waits for init-selkies-end), so with-contenv gives us the value
#   the base acts on.
# - Rust Selkies base: the session restarts the app at once (SELKIES_APP_RESTART, which
#   RESTART_APP turns on), or stops the container when the app exits (EXIT_ON_APP_CLOSE).
# Prints the first conflicting setting, or nothing.
conflicting_setting() {
  if is_true "${EXIT_ON_APP_CLOSE:-}"; then
    echo "EXIT_ON_APP_CLOSE"
  elif is_true "${SELKIES_APP_RESTART:-}"; then
    echo "SELKIES_APP_RESTART"
  elif is_true "${RESTART_APP:-}"; then
    echo "RESTART_APP"
  fi
}

# The log line for a conflict, with a hint when HARDEN_OPENBOX may be what turned the restarter
# on: it sets RESTART_APP on both bases, and on the Rust base RESTART_APP then sets
# SELKIES_APP_RESTART.
log_conflict() {
  local conflict="$1"
  local hint=""
  if [ "$conflict" != "EXIT_ON_APP_CLOSE" ] && is_true "${HARDEN_OPENBOX:-}"; then
    hint=" (HARDEN_OPENBOX=true turns RESTART_APP on unless you set RESTART_APP=false)"
  fi
  log "${conflict} is on; IDLE_QUIT stays off, because the app would be restarted (or the container stopped) after every idle close${hint}"
}

install_hooks() {
  printf '%s' "$connect_hook" > "${env_dir}/SELKIES_RUN_AFTER_CONNECT"
  printf '%s' "$disconnect_hook" > "${env_dir}/SELKIES_RUN_AFTER_DISCONNECT"
}

main() {
  # Read before clearing: these are the values from the container's environment.
  local user_connect_hook="${SELKIES_RUN_AFTER_CONNECT:-}"
  local user_disconnect_hook="${SELKIES_RUN_AFTER_DISCONNECT:-}"
  clear_previous_state

  if ! idle_quit_enabled; then
    return
  fi
  if is_foreign_hook "$user_connect_hook" "$connect_hook" \
    || is_foreign_hook "$user_disconnect_hook" "$disconnect_hook"; then
    log "SELKIES_RUN_AFTER_CONNECT or SELKIES_RUN_AFTER_DISCONNECT is already set; IDLE_QUIT stays off so your hooks keep working"
    return
  fi
  local conflict
  conflict="$(conflicting_setting)"
  if [ -n "$conflict" ]; then
    log_conflict "$conflict"
    return
  fi

  create_runtime_dir
  install_hooks
}

main
