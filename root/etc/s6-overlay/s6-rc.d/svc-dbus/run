#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Disable the base image's *system* D-Bus, as docker-orcaslicer does after hostname1
# activation failed there with permission errors (docker-orcaslicer #24). The app runs fine
# without it. The *session* bus (single-instance forwarding) comes from X11 autolaunch and is
# unaffected.

sleep infinity
