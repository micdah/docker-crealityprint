+    async def _key_loop_tick(self, interval: float) -> None:
+        """docker-crealityprint: sleep one loop interval, then park while no key or
+        gamepad is held. Only a client message (`on_message`) can make one held, and it
+        sets `input_wake` once handled, so the key loops don't wake 60 times a second
+        with nobody connected."""
